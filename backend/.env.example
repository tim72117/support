# 複製這個檔案為 .env，並填入你自己的實際值。
# .env 本身會被 .gitignore 排除，不會進版控。

DATABASE_URL=postgres://platform:platform@localhost:5434/platform?sslmode=disable

ADDR=:8082
ALLOWED_ORIGIN=http://localhost:5175
COOKIE_SECURE=false

# Google Cloud Console 建立 OAuth 2.0 Client ID（Web application 型）後填入：
# Authorized redirect URIs 要加 http://localhost:8082/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8082/auth/google/callback

CONSOLE_URL=http://localhost:5175
