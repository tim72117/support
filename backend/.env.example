# 複製這個檔案為 .env，並填入你自己的實際值。
# .env 本身會被 .gitignore 排除，不會進版控。

DATABASE_URL=postgres://platform:platform@localhost:5434/platform?sslmode=disable

ADDR=:8082
# 多個來源用逗號分隔：console（5177）與 landing（5176，訂閱頁與金流測試頁）
ALLOWED_ORIGIN=http://localhost:5177,http://localhost:5176
COOKIE_SECURE=false

# Google Cloud Console 建立 OAuth 2.0 Client ID（Web application 型）後填入：
# Authorized redirect URIs 要加 http://localhost:8082/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8082/auth/google/callback

CONSOLE_URL=http://localhost:5177

# TapPay（金流）。先用 Sandbox：到 TapPay Portal 取得下列四個值。
# 沒填 PARTNER_KEY / MERCHANT_ID 時，後端照常啟動，只是訂閱付款功能關閉。
# APP_ID / APP_KEY 是給瀏覽器端 TPDirect.setupSDK 用的（可公開）；
# PARTNER_KEY 是伺服器端密鑰，絕對不要放進前端或 commit。
TAPPAY_APP_ID=
TAPPAY_APP_KEY=
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
# 上線收真錢時才改成 production（需先通過 TapPay 特店審核）。
TAPPAY_ENV=sandbox

# 設成 false 會關閉用量額度（同時關閉訂閱付款）。
QUOTA_ENABLED=true

# 消費端對話頁（apps/support）的來源，逗號分隔。用於 /public/* 的 CORS（不帶憑證），
# 同時會登記為每個 onagent app 的 allowed origins（瀏覽器端 API key 只能從這些來源使用）。
PUBLIC_ALLOWED_ORIGIN=http://localhost:5178
# 部署在反向代理後面時設成 true，速率限制才會用 X-Forwarded-For 取得真實 IP。
PUBLIC_TRUST_PROXY=false

# onagent 串接（業務帳號）。兩個都沒填時整個功能關閉：後端照常啟動，
# 業主資料照存，但不會在 onagent 建 app，消費端頁面回報「目前無法服務」。
# ONAGENT_TOKEN 是 onagent 業務帳號的 bearer token（usertoken），絕對不要 commit。
ONAGENT_BASE_URL=
ONAGENT_TOKEN=
# 選填：預設由 ONAGENT_BASE_URL 推得（http→ws、https→wss，加 /ws）。
ONAGENT_WS_URL=
# 選填：產生的 onagent app id 前綴（預設 aisupport-）。
ONAGENT_APP_ID_PREFIX=
