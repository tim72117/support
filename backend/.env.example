# 複製這個檔案為 .env，並填入你自己的實際值。
# .env 本身會被 .gitignore 排除，不會進版控。

DATABASE_URL=postgres://platform:platform@localhost:5434/platform?sslmode=disable

ADDR=:8082
# 多個來源用逗號分隔：console、landing（金流測試頁在 landing 的 5201）
ALLOWED_ORIGIN=http://localhost:5175,http://localhost:5201
COOKIE_SECURE=false

# Google Cloud Console 建立 OAuth 2.0 Client ID（Web application 型）後填入：
# Authorized redirect URIs 要加 http://localhost:8082/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8082/auth/google/callback

CONSOLE_URL=http://localhost:5175

# TapPay（金流）。先用 Sandbox：到 TapPay Portal 取得下列四個值。
# 沒填 PARTNER_KEY / MERCHANT_ID 時，後端照常啟動，只是訂閱付款功能關閉。
# APP_ID / APP_KEY 是給瀏覽器端 TPDirect.setupSDK 用的（可公開）；
# PARTNER_KEY 是伺服器端密鑰，絕對不要放進前端或 commit。
TAPPAY_APP_ID=
TAPPAY_APP_KEY=
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
# 上線收真錢時才改成 production（需先通過 TapPay 特店審核）。
TAPPAY_ENV=sandbox

# 設成 false 會關閉用量額度（同時關閉訂閱付款）。
QUOTA_ENABLED=true
